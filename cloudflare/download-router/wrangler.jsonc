{
  "name": "claude-app-mirror-download-router",
  "main": "src/index.js",
  "compatibility_date": "2026-06-04",
  "workers_dev": false,
  "vars": {
    "GLOBAL_MIRROR_BASE_URL": "https://claudeapp-r2.agentsmirror.com",
    "SECONDARY_COUNTRY_CODES": "CN",
    "SECONDARY_S3_SIGNED_URL_TTL_SECONDS": "600",
    "SECONDARY_S3_METADATA_TTL_SECONDS": "120",
    "ANALYTICS_EXTENDED_BLOBS": "1",
    "BLOCK_MODE": "enforce",
    "TERMS_HOME_URL": "https://github.com/Wangnov/claude-app-mirror",
    "TERMS_URL": "https://github.com/Wangnov/claude-app-mirror/blob/main/TERMS.md",
    "SOURCE_REPO_URL": "https://github.com/Wangnov/claude-app-mirror",
    "OFFICIAL_CHANNELS_HINT": "claude.ai/download / downloads.claude.ai",
    "INFRA_ATTRIBUTION": "part of the agentsmirror non-commercial open-source mirror network",
    "INFRA_ATTRIBUTION_CN": "在线分发路由与存储属于 agentsmirror 开源公益镜像基础设施（含与姐妹项目共享的科研/开源公益节点体系）",
    "BLOCKED_REFERER_HOSTS": [
      "dqtx.cc",
      "opchat.eu.org",
      "ccwu.cc"
    ],
    "BLOCKED_UA_SUBSTRINGS": [
      "kakou/",
      "越途ai智枢",
      "yuetunexus",
      "relayautoconfig",
      "relayassistant",
      "pojiamanager",
      "yrbridge-claudemirror",
      "ldxp-card-admin",
      "jieshangai-installer",
      "yaoyao-claude",
      "yaoyao-chatgpt",
      "ccswitchpro-resourceworker",
      "nicecodetools",
      "tianyulink-installer",
      "yihaogpt-tools"
    ],
    "ROUTE_CONFIG": {
      "aliases": {
        "/latest/mac": {
          "category": "installer",
          "filename": "Claude-mac-universal.dmg",
          "contentType": "application/x-apple-diskimage"
        },
        "/latest/win-x64": {
          "category": "installer",
          "filename": "Claude-win-x64.msix",
          "contentType": "application/vnd.ms-appx"
        },
        "/latest/win-arm64": {
          "category": "installer",
          "filename": "Claude-win-arm64.msix",
          "contentType": "application/vnd.ms-appx"
        },
        "/latest/linux-x64": {
          "category": "installer",
          "filename": "Claude-linux-x64.deb",
          "contentType": "application/octet-stream"
        },
        "/latest/linux-arm64": {
          "category": "installer",
          "filename": "Claude-linux-arm64.deb",
          "contentType": "application/octet-stream"
        },
        "/latest/checksums": {
          "category": null,
          "filename": "SHA256SUMS.txt",
          "contentType": "text/plain; charset=utf-8"
        },
        "/latest/manifest": {
          "category": null,
          "filename": "release-manifest.json",
          "contentType": "application/json"
        }
      },
      "patterns": []
    }
  },
  "routes": [
    {
      "pattern": "claudeapp.agentsmirror.com/latest/*",
      "zone_id": "a5bae9b722f3c5fe1a24aaebe7a8e663"
    },
    {
      "pattern": "claudeapp.agentsmirror.com/stats/*",
      "zone_id": "a5bae9b722f3c5fe1a24aaebe7a8e663"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "DOWNLOAD_ANALYTICS",
      "dataset": "claude_mirror_downloads"
    },
    {
      "binding": "ABUSE_ANALYTICS",
      "dataset": "claude_mirror_abuse"
    }
  ]
}
